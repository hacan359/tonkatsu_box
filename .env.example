# Copy to .env and edit. Every line is optional; defaults in parentheses.

# Host folder for all server data: db, covers cache, snapshots, keys.json (./data)
#TONKATSU_DATA_PATH=./data

# Host port of the web UI (8080)
#TONKATSU_PORT=8080

# Access token for the web UI (off). "token" makes the server require one:
# it prints a sign-in link ("Sign in: http://…/?token=…" in
# `docker compose logs tonkatsu`) and keeps the token in
# <TONKATSU_DATA_PATH>/auth_token. TONKATSU_AUTH_TOKEN sets it explicitly.
#TONKATSU_AUTH=off
#TONKATSU_AUTH_TOKEN=

# Host interface the web UI is published on (0.0.0.0 = every interface).
# 127.0.0.1 keeps it reachable from this machine only.
#TONKATSU_BIND=0.0.0.0

# Hosts the server may fetch covers from for the web client: comma-separated
# domain roots, subdomains included (any host when empty). Redirects are
# checked hop by hop, so list the redirect targets too.
#TONKATSU_IMAGE_HOSTS=

# Owner (uid/gid) of the files in the data folder (1000/1000)
#PUID=1000
#PGID=1000

# API keys; override the same names in keys.json
#TONKATSU_KEY_TMDB=
#TONKATSU_KEY_TVDB=
#TONKATSU_KEY_IGDB_CLIENT_ID=
#TONKATSU_KEY_IGDB_CLIENT_SECRET=
#TONKATSU_KEY_STEAMGRIDDB=
#TONKATSU_KEY_COMICVINE=
#TONKATSU_KEY_GOOGLEBOOKS=
#TONKATSU_KEY_HARDCOVER=
#TONKATSU_KEY_RA_USERNAME=
#TONKATSU_KEY_RA=
#TONKATSU_KEY_SIMKL_CLIENT_ID=
#TONKATSU_KEY_SS_DEV_ID=
#TONKATSU_KEY_SS_DEV_PASSWORD=
#TONKATSU_KEY_SS_SSID=
#TONKATSU_KEY_SS_SSPASSWORD=
